# ==============================================================================
# FitLog Pro: Enterprise Monorepo .gitignore
# Production-grade Git exclusion rules for Web (React/Vite), Mobile (Flutter/Dart),
# Serverless Functions (Neon/Vercel), and Test Harnesses.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPERATING SYSTEM & METADATA FILES
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 2. IDE, EDITORS & WORKSPACES
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / IntelliJ / Android Studio / WebStorm
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text & TextMate
*.sublime-workspace
*.sublime-project
*.tmproj
*.tmproject

# Vim / Emacs swap and backup files
*.swp
*.swo
*~
\#*\#
.\#*

# ------------------------------------------------------------------------------
# 3. NODE & FRONTEND DEPENDENCIES & ARTIFACTS
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Frontend Build & Compilation Outputs
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
.turbo/
*/.turbo/
.vite/
*/.vite/
*.tsbuildinfo

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. SECRETS, CREDENTIALS & LOCAL CONFIGURATION
# ------------------------------------------------------------------------------
# Never commit private environment files or API keys
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example

# Local deployment & database state
.neon
.neon/
*/.neon/
.vercel/
*/.vercel/

# ------------------------------------------------------------------------------
# 5. TESTING, PLAYWRIGHT & CODE QUALITY ARTIFACTS
# ------------------------------------------------------------------------------
# Test runs & Playwright outputs
test-results/
*/test-results/
playwright-report/
*/playwright-report/
e2e-results/
*/e2e-results/
.playwright-mcp/
*/.playwright-mcp/

# Code Coverage
coverage/
*/coverage/
.nyc_output/
*.lcov

# QA & benchmark scratch output
docs/qa/results/
docs/performance/results/

# ------------------------------------------------------------------------------
# 6. FLUTTER & DART MOBILE ARTIFACTS
# ------------------------------------------------------------------------------
fitlog_pro/.dart_tool/
fitlog_pro/.flutter-plugins
fitlog_pro/.flutter-plugins-dependencies
fitlog_pro/.packages
fitlog_pro/.pub-cache/
fitlog_pro/.pub/
fitlog_pro/build/
fitlog_pro/android/.gradle/
fitlog_pro/android/local.properties
fitlog_pro/ios/.generated/
fitlog_pro/ios/Flutter/Generated.xcconfig
fitlog_pro/ios/Flutter/flutter_export_environment.sh

# ------------------------------------------------------------------------------
# 7. TEMPORARY EXPORTS, MEDIA SCRATCH & LARGE BUNDLES
# ------------------------------------------------------------------------------
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.tmp
*.log
logs/
*/logs/

# Temporary media generation & demo captures
demo_videos/
netlify_deploy/
scratch/
saas_spec_extracted.txt
test_paths.js
