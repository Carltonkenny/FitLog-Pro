{
  "name": "fitlog-pro-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/runner/register.mjs --test \"tests/unit/*.test.js\" \"tests/security/*.test.js\" \"tests/database/*.test.js\"",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "qa:docs": "node scripts/qa-docs.mjs",
    "build:perf": "vite build --outDir dist-perf",
    "perf": "node --experimental-strip-types scripts/perf-measure.mjs",
    "test:unit": "node --import ./tests/runner/register.mjs --test \"tests/unit/*.test.js\"",
    "test:security": "node --import ./tests/runner/register.mjs --test \"tests/security/*.test.js\"",
    "test:database": "node --import ./tests/runner/register.mjs --test \"tests/database/*.test.js\"",
    "test:live": "node --env-file-if-exists=.env --import ./tests/runner/register.mjs --test \"tests/integration/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.1.2",
    "@neondatabase/neon-js": "^0.9.0-beta",
    "canvas-confetti": "^1.9.4",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "vite": "^6.2.0"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
