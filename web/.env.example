# FitLog Pro: local test settings (safe to share)
# These three are PUBLIC addresses, the same ones the website ships to every visitor.
# They point at the live FitLog backend on Neon, so the app works locally with real sign-up and sync.
# Copy this file to `.env` inside the `web` folder, then run: npm install && npm run dev
NEON_AUTH_BASE_URL=https://ep-ancient-king-b3isnfrw.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_FUNCTION_API_BASE_URL=https://br-raspy-smoke-b3c0n0we-api.compute.c-4.ap-southeast-1.aws.neon.tech
NEON_REALTIME_URL=wss://ep-ancient-king-b3isnfrw.rt.c-4.ap-southeast-1.aws.neon.tech/

# Optional switches
# Turn on only after enabling Google under Auth providers in the Neon console and adding the site domain.
VITE_GOOGLE_AUTH=false
VITE_SKIP_AUTH=false

# NOT needed to run or test the app, and never shared: DATABASE_URL, NEON_REALTIME_SECRET and GEMINI_API_KEY.
# They live only on the server function. See analysis/launch-guide.md.
