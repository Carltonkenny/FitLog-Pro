# FitLog Pro environment. Copy to .env and fill in, or run `neon deploy` which writes the Neon values for you.
# Public values (safe in the browser):
NEON_AUTH_BASE_URL=
NEON_FUNCTION_API_BASE_URL=
NEON_REALTIME_URL=
# Optional: show the Google button (uses Neon's shared development keys until you add your own)
VITE_GOOGLE_AUTH=false
# Dev only: open /app without signing in (ignored in production builds)
VITE_SKIP_AUTH=false

# Secrets: never commit, never prefix with VITE_. `neon deploy` writes these:
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_REALTIME_SECRET=
# For deploying the API function, put these in web/.env.production and run `neon deploy --env .env.production`:
# GEMINI_API_KEY=
# ALLOWED_ORIGINS=https://your-site.netlify.app
